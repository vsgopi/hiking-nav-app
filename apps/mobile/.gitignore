# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# cached Overpass API responses from scripts/ingest-te-araroa.ts
/scripts/.cache/

# Te Araroa Trust GPX zip/extract — boundary-cutting reference ONLY, used
# transiently by scripts/lib/trustBoundaries.ts. Must never be committed or
# bundled: nothing in this directory is OSM-sourced, and no Trust geometry
# may be persisted anywhere in this app (see Phase 2 provenance design).
/scripts/.cache-trust-boundaries/

# non-shipped ingest validation reports (scripts/ingest-te-araroa.ts)
/scripts/.out/
